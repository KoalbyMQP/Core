# Build from the Core repo root:
#   docker build -t poc-demo-ros:dev -f pkgs/poc-demo/Dockerfile-ros .
FROM ros:humble

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3-pip \
    python3-colcon-common-extensions \
    ros-humble-ament-cmake \
    ros-humble-rmw-cyclonedds-cpp && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /ros_ws
COPY pkgs/poc-demo /ros_ws/src/poc-demo
COPY pkgs/poc-demo/bridge.toml /ros_ws/bridge.toml

RUN /bin/bash -c 'source /opt/ros/humble/setup.bash && \
    if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi && \
    python3 -m pip install --upgrade pip https://github.com/KoalbyMQP/Urchin-Framework/releases/download/crab-api/crab_api-0.1.1-py3-none-any.whl \
    rosdep update && \
    rosdep install --from-paths src --ignore-src -r -y && \
    colcon build --packages-select poc_demo && \
    rm -rf build log'

# Embedded manifest read by Cortex's POST /requirements/discover.
COPY pkgs/poc-demo/zaraos.json /etc/zaraos/package.json

ENV ROS_DOMAIN_ID=42
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ENV URCHIN_PORT=socket://10.0.2.2:5555

ENTRYPOINT ["/bin/bash", "-c", \
    "source /opt/ros/humble/setup.bash && \
     source /ros_ws/install/setup.bash && \
     ros2 run poc_demo demo_node"]
