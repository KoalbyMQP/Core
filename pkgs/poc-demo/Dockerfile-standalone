# Build with the following from this directory:
#
#   docker buildx build \
#     --platform linux/arm64 \
#     -f Dockerfile-standalone \
#     -t poc-demo-standalone:dev \
#     --load .
#
# Then save with:
#
#   docker save poc-demo-standalone:dev -o /tmp/share/poc-demo-standalone.tar
#
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    URCHIN_PORT=socket://10.0.2.2:5555

WORKDIR /app

COPY pyproject.toml ./
RUN uv pip install --no-cache-dir --system -r pyproject.toml

COPY poc_demo ./poc_demo/
COPY bridge.toml ./bridge.toml

# Embed ZaraOS package manifest so Cortex auto-discovery can resolve
# device passthrough, dependencies, and health check config.
COPY zaraos.json /etc/zaraos/package.json

# Run the Python module for poc_status
CMD ["python", "-m", "poc_demo.demo_standalone"]
